{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
                "StringEquals": {
                    "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                    "token.actions.githubusercontent.com:sub": "repo:your-org@123456/your-repo@789012:environment:production",
                    "token.actions.githubusercontent.com:repository": "your-org/your-repo",
                    "token.actions.githubusercontent.com:repository_id": "789012",
                    "token.actions.githubusercontent.com:repository_owner_id": "123456",
                    "token.actions.githubusercontent.com:ref": "refs/heads/main",
                    "token.actions.githubusercontent.com:environment": "production"
                }
            }
        }
    ]
}
